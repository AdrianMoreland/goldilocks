# Dependencies
node_modules/

# Build output — NOT dist/ or build/: Railway's build step (Railpack) uses
# this file to decide what to carry from the build stage into the final
# runtime image, so gitignoring the compiled output here hid apps/api/dist
# and apps/web/dist from the deployed container (Cannot find module
# 'dist/main'). Keeping these out of git is a smaller win than a working
# deploy, so they're tracked-but-empty by convention instead.
.turbo/
*.tsbuildinfo

# Prisma generated client
apps/api/prisma/generated/

# Stray compiled output next to .ts source — apps/api's real build output is
# apps/api/dist/ (tracked deliberately, see above); a .js/.d.ts sitting next
# to a same-named .ts file only ever means a stray `tsc`/`ts-node` run
# compiled in place by mistake, so it's always safe to ignore.
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
apps/api/src/**/*.d.ts.map
apps/api/prisma/*.js
apps/api/prisma/*.js.map

# Generated reports / docs
apps/api/documentation/
apps/api/nestjs-doctor-report.html

# Environment variables
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Test coverage
coverage/
.nyc_output/
