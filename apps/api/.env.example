# Postgres via Supabase — pooled (queries) and direct (migrations) connections
DATABASE_URL=
DIRECT_URL=

# Supabase project + the new key format (sb_publishable_.../sb_secret_...)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Live metal spot prices
METALPRICE_API_KEY=

# Redis — cache-aside store for products/spot prices
REDIS_URL=

# Web app origin(s) allowed to call this API, comma-separated
FRONTEND_URL=http://localhost:5173

# Internal AI assistant (docs/AI-AGENT-PLAN.md). Switched off unless AI_ENABLED is exactly "true".
# AI_PROVIDER picks the model vendor: anthropic or openai (rollback). Unset: openai if only OPENAI_API_KEY is set, else anthropic.
# Use a key from a workspace used only by this app, with prepaid credit and a monthly spend limit;
# the provider's key is only required when AI_ENABLED=true.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# How much the model reasons before answering: low (default), medium, high, xhigh, max. Anthropic only.
AI_EFFORT=low
# Output caps include the model's reasoning, so keep them generous (defaults shown).
AI_MAX_OUTPUT_TOKENS=2000
AI_DRAFT_MAX_OUTPUT_TOKENS=4000
# Rollback only: AI_PROVIDER=openai with OPENAI_API_KEY and AI_MODEL=gpt-4o-mini.
OPENAI_API_KEY=
# Limits (defaults shown). The daily budget is a company-wide ceiling in USD; when today's spend reaches it the assistant pauses until tomorrow.
AI_DAILY_QUOTA_PER_USER=50
AI_PER_MINUTE_LIMIT=5
AI_DAILY_BUDGET_USD=2
AI_LOG_RETENTION_DAYS=90
AI_CACHE_TTL_DAYS=7
# AI_PRICE_PER_MILLION=0.10,0.01,0.50   (USD per million tokens: input,cachedInput,output — only for a model the built-in price table doesn't know)
# AI_TEMPERATURE=   (OpenAI only, leave unset unless needed; Claude models reject sampling settings and it is ignored there)

PORT=4000
NODE_ENV=development

# Roadmap sync (roadmap 1.20). Fine-grained PAT limited to this repo: Contents, Pull requests and Issues read/write.
# Without it the Project page shows the sync as "not configured". GITHUB_REPO defaults to AdrianMoreland/goldilocks.
GITHUB_SYNC_TOKEN=
GITHUB_REPO=
# Shared secret for the GitHub webhook that tells the API about pushes to main (Settings > Webhooks > Secret).
# The webhook's Payload URL is https://<this API>/roadmap/sync/webhook, content type application/json, push events only.
# Without it the webhook endpoint refuses every call.
GITHUB_WEBHOOK_SECRET=
# Optional, default off. true lets the 06:15 daily job also send the app's roadmap edits to GitHub as a PR (the safety-net pull always runs).
ROADMAP_DAILY_PUSH=
