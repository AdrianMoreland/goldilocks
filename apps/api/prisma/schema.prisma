generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// @description Unique numeric user identifier
  /// @example 123
  id          String    @id @default(uuid())
  /// @description the username
  email       String    @unique
  firstName   String
  lastName    String
  /// @description the hashed password of the user\'s account
  password    String
  role        UserRole
  /// @description Indicates if the user is allowed to use the application
  isActive    Boolean   @default(true)
  /// @description Indicates if the user is an admin or not
  admin       Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  lastLoginAt DateTime?

  @@map("users")
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  name        String
  metalType   MetalType
  /// Weight in grams
  weight      Decimal   @db.Decimal(10, 4)
  /// Dealer spread applied to spot price
  spreadBuy   Decimal   @db.Decimal(5, 4)
  spreadSell  Decimal   @db.Decimal(5, 4)
  /// VAT rate (0.00 or 0.23)
  vatRate     Decimal   @db.Decimal(4, 2)
  stock       Int       @default(0)
  /// Whether this product is shown/sellable — admin-toggleable, doesn't delete the row.
  isActive    Boolean   @default(true)
  /// Bar or coin, chosen when the product is created. Null on older rows —
  /// the dashboard then infers it from the name.
  category    ProductCategory?
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete — set instead of removing the row, so a deleted product
  /// is hidden everywhere but can be restored from the admin panel.
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([metalType])
  @@index([metalType, stock])
  @@index([sku])
  @@map("products")
}

model MetalSpotPrice {
  id        BigInt    @id @default(autoincrement())
  metalType MetalType
  priceEur  Decimal   @db.Decimal(18, 6)
  priceGbp  Decimal   @db.Decimal(18, 6)
  // previousPrice Decimal   @db.Decimal(18, 6)

  /// API provider name (metalsapi, goldapi, etc)
  source    String
  /// timestamp of the market price
  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Unique compound key to allow upsert on metalType + timestamp
  @@unique([metalType, timestamp])
  /// Indexes for query performance
  @@index([metalType])
  @@index([timestamp])
  @@map("metal_spot_prices")
}

model HistoricSpotPrice {
  id         BigInt    @id @default(autoincrement())
  metalType  MetalType
  priceEur   Decimal   @db.Decimal(18, 6)
  priceGbp   Decimal   @db.Decimal(18, 6)
  recordedAt DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([metalType, recordedAt])
  /// Indexes for query performance
  @@index([metalType])
  @@index([recordedAt])
  @@map("historic_spot_prices")
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  currency  Currency @default(EUR)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("branches")
}

/// One row per call to the external metal-price vendor API (not per metal —
/// the vendor returns all four metals in a single call, so "attempt" maps
/// to that one HTTP round-trip). Powers the admin System Status panel's
/// fetch-success-rate/latency metrics and its "last N attempts" log.
model FetchAttempt {
  id             BigInt       @id @default(autoincrement())
  attemptedAt    DateTime     @default(now()) @db.Timestamptz(6)
  durationMs     Int
  success        Boolean
  errorMessage   String?
  /// Metals that actually got a usable (>0) rate back — empty on a fully failed call.
  metalsResolved MetalType[]
  triggeredBy    FetchTrigger

  @@index([attemptedAt])
  @@map("fetch_attempts")
}

enum FetchTrigger {
  CRON
  REFRESH
  RETRY
  LAUNCH_FALLBACK
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  ACCOUNTING
  AUDITOR
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  PALLADIUM
}

enum ProductCategory {
  BAR
  COIN
}

enum Currency {
  EUR
  USD
  GBP
}

/// One Standard Operating Procedure, imported from docs/sops/*.md (format:
/// docs/sops/00-README.md). The Markdown is the content; everything else is
/// the frontmatter, so the importer can round-trip a file without loss.
/// Enum values are lowercase on purpose: they are exactly the frontmatter
/// values and the shared-types Zod enums, so no mapping layer is needed.
model KbDocument {
  id               Int            @id @default(autoincrement())
  /// Stable link key. Never changes after approval — `[[slug#section]]` links depend on it.
  slug             String         @unique
  title            String
  category         KbCategory
  jurisdiction     KbJurisdiction
  owner            String
  status           KbStatus       @default(draft)
  version          Int            @default(1)
  /// The SOP's own date (frontmatter `updatedAt`) — drives the 6-month review reminder, unlike the row's `updatedAt`.
  contentUpdatedOn DateTime       @db.Date
  markdown         String
  /// sha256 of the source file, so a re-import can skip files that haven't changed.
  contentHash      String
  /// True once an admin has changed the content in the app. A re-import of the SOP file would
  /// silently overwrite that work, so the importer refuses unless told to force it.
  editedInApp      Boolean        @default(false)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  @@index([category, status])
  @@map("kb_documents")
}

enum KbCategory {
  sales
  trading
  operations
  compliance
  storage
  systems
  directory
  meta
}

enum KbJurisdiction {
  all
  IE
  UK
  ES
}

enum KbStatus {
  draft
  approved
  retired
}

/// One row per question asked of the internal assistant (roadmap 1.5). The question is stored
/// already scrubbed of names, emails and phone numbers; the answer and any live prices are
/// never stored here. Purged after AI_LOG_RETENTION_DAYS.
model AiQuestionLog {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  userId            String
  /// Scrubbed text — see privacy-scrubber.ts.
  question          String
  /// answered | refused | uncited | error
  status            String
  /// procedures | email | whatsapp. For the last two, `question` holds a placeholder, not the customer's message.
  mode              String   @default("procedures")
  /// Live lookups the answer used (getSpot, findProductPrices); never their results.
  toolNames         String[]
  cached            Boolean  @default(false)
  /// True when the first answer cited nothing and a second model call was made.
  retried           Boolean  @default(false)
  /// "slug#anchor" for each section the answer cited.
  citations         String[]
  model             String
  corpusHash        String
  inputTokens       Int
  cachedInputTokens Int
  outputTokens      Int
  /// Whole micro-dollars (1 USD = 1,000,000): exact integers, so the daily spend sum never drifts.
  costMicros        Int
  latencyMs         Int
  /// Failure kind when status is "error" (unavailable, out_of_credit, …).
  error             String?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_question_logs")
}

/// A repeat question's answer, keyed by the normalised scrubbed question and the SOP-set hash,
/// so approving or editing any SOP stops old answers being served. Only questions with nothing
/// to scrub, and answers produced without live-price tools, are ever stored.
model AiAnswerCache {
  id          Int      @id @default(autoincrement())
  questionKey String
  corpusHash  String
  answer      String
  status      String
  /// AiCitation[] as validated when the answer was made.
  citations   Json
  model       String
  hits        Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)

  @@unique([questionKey, corpusHash])
  @@index([expiresAt])
  @@map("ai_answer_cache")
}

/// The company-wide market mode (Weekend / Volatile / Metal Shortage), shared by every user. A single
/// row with id 1; no row means Standard. updatedBy is a display name, kept as text so a deleted user
/// does not orphan it.
model MarketModeState {
  id        Int      @id
  weekend   Boolean  @default(false)
  volatile  Boolean  @default(false)
  shortage  Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("market_mode_state")
}

/// docs/ROADMAP.md as stored for the Project Management page: one row (id 1) holding the whole Markdown.
/// `version` is bumped on every save so two editors cannot silently overwrite each other. The file in
/// the repo stays the reviewed copy: `pnpm --filter api roadmap:import` / `roadmap:export` move it either way.
model RoadmapDocument {
  id        Int      @id
  markdown  String
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("roadmap_document")
}
