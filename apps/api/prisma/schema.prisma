generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// @description Unique numeric user identifier
  /// @example 123
  id          String    @id @default(uuid())
  /// @description the username
  email       String    @unique
  firstName   String
  lastName    String
  /// @description the hashed password of the user\'s account
  password    String
  role        UserRole
  /// @description Indicates if the user is allowed to use the application
  isActive    Boolean   @default(true)
  /// @description Indicates if the user is an admin or not
  admin       Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  lastLoginAt DateTime?
  /// The branch this person works from. Null behaves as an Irish branch (see branch-access.ts in
  /// shared-types), so accounts that predate branches keep what they had.
  branchId    Int?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@map("users")
}

model Product {
  salesProducts SalesProduct[]
  id            Int              @id @default(autoincrement())
  sku           String           @unique
  name          String
  metalType     MetalType
  /// Weight in grams
  weight        Decimal          @db.Decimal(10, 4)
  /// Dealer spread applied to spot price
  spreadBuy     Decimal          @db.Decimal(5, 4)
  spreadSell    Decimal          @db.Decimal(5, 4)
  /// VAT rate (0.00 or 0.23)
  vatRate       Decimal          @db.Decimal(4, 2)
  stock         Int              @default(0)
  /// Whether this product is shown/sellable — admin-toggleable, doesn't delete the row.
  isActive      Boolean          @default(true)
  /// Bar or coin, chosen when the product is created. Null on older rows —
  /// the dashboard then infers it from the name.
  category      ProductCategory?
  description   String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  /// Soft delete — set instead of removing the row, so a deleted product
  /// is hidden everywhere but can be restored from the admin panel.
  deletedAt     DateTime?        @db.Timestamptz(6)

  bcItems          BcItem[]
  trades           Trade[]
  lots             PurchaseLot[]
  aliases          ProductAlias[]
  suggestedAliases ProductAlias[] @relation("AliasSuggestedProduct")
  zohoProducts     ZohoProduct[]
  items            Item[]

  @@index([metalType])
  @@index([metalType, stock])
  @@index([sku])
  @@map("products")
}

model MetalSpotPrice {
  id        BigInt    @id @default(autoincrement())
  metalType MetalType
  priceEur  Decimal   @db.Decimal(18, 6)
  priceGbp  Decimal   @db.Decimal(18, 6)
  // previousPrice Decimal   @db.Decimal(18, 6)

  /// API provider name (metalsapi, goldapi, etc)
  source    String
  /// timestamp of the market price
  timestamp DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Unique compound key to allow upsert on metalType + timestamp
  @@unique([metalType, timestamp])
  /// Indexes for query performance
  @@index([metalType])
  @@index([timestamp])
  @@map("metal_spot_prices")
}

model HistoricSpotPrice {
  id         BigInt    @id @default(autoincrement())
  metalType  MetalType
  priceEur   Decimal   @db.Decimal(18, 6)
  priceGbp   Decimal   @db.Decimal(18, 6)
  recordedAt DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([metalType, recordedAt])
  /// Indexes for query performance
  @@index([metalType])
  @@index([recordedAt])
  @@map("historic_spot_prices")
}

model Branch {
  id        Int           @id @default(autoincrement())
  name      String
  address   String?
  /// IE and ES branches see the whole app; UK branches lose the Pricing Workbook and see only shared SOPs.
  region    BranchRegion  @default(IE)
  currency  Currency      @default(EUR)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  users     User[]
  trades    Trade[]
  lots      PurchaseLot[]

  @@map("branches")
}

/// One row per call to the external metal-price vendor API (not per metal —
/// the vendor returns all four metals in a single call, so "attempt" maps
/// to that one HTTP round-trip). Powers the admin System Status panel's
/// fetch-success-rate/latency metrics and its "last N attempts" log.
model FetchAttempt {
  id             BigInt       @id @default(autoincrement())
  attemptedAt    DateTime     @default(now()) @db.Timestamptz(6)
  durationMs     Int
  success        Boolean
  errorMessage   String?
  /// Metals that actually got a usable (>0) rate back — empty on a fully failed call.
  metalsResolved MetalType[]
  triggeredBy    FetchTrigger

  @@index([attemptedAt])
  @@map("fetch_attempts")
}

enum FetchTrigger {
  CRON
  REFRESH
  RETRY
  LAUNCH_FALLBACK
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  ACCOUNTING
  AUDITOR
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  PALLADIUM
}

enum ProductCategory {
  BAR
  COIN
}

enum Currency {
  EUR
  USD
  GBP
}

/// One Standard Operating Procedure, imported from docs/sops/*.md (format:
/// docs/sops/00-README.md). The Markdown is the content; everything else is
/// the frontmatter, so the importer can round-trip a file without loss.
/// Enum values are lowercase on purpose: they are exactly the frontmatter
/// values and the shared-types Zod enums, so no mapping layer is needed.
model KbDocument {
  id               Int            @id @default(autoincrement())
  /// Stable link key. Never changes after approval — `[[slug#section]]` links depend on it.
  slug             String         @unique
  title            String
  category         KbCategory
  jurisdiction     KbJurisdiction
  owner            String
  status           KbStatus       @default(draft)
  visibility       KbVisibility   @default(ie_only)
  version          Int            @default(1)
  /// The SOP's own date (frontmatter `updatedAt`) — drives the 6-month review reminder, unlike the row's `updatedAt`.
  contentUpdatedOn DateTime       @db.Date
  markdown         String
  /// sha256 of the source file, so a re-import can skip files that haven't changed.
  contentHash      String
  /// True once an admin has changed the content in the app. A re-import of the SOP file would
  /// silently overwrite that work, so the importer refuses unless told to force it.
  editedInApp      Boolean        @default(false)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  @@index([category, status])
  @@map("kb_documents")
}

enum KbCategory {
  sales
  trading
  operations
  compliance
  storage
  systems
  directory
  meta
}

enum KbJurisdiction {
  all
  IE
  UK
  ES
}

/// Which branches may read a SOP. Defaults to the pre-branch behaviour (Irish only); an admin opts a SOP in.
enum KbVisibility {
  all
  ie_only
}

enum BranchRegion {
  IE
  UK
  ES
}

enum KbStatus {
  draft
  approved
  retired
}

/// One row per question asked of the internal assistant (roadmap 1.5). The question is stored
/// already scrubbed of names, emails and phone numbers; the answer and any live prices are
/// never stored here. Purged after AI_LOG_RETENTION_DAYS.
model AiQuestionLog {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  userId            String
  /// Scrubbed text — see privacy-scrubber.ts.
  question          String
  /// answered | refused | uncited | error
  status            String
  /// procedures | email | whatsapp. For the last two, `question` holds a placeholder, not the customer's message.
  mode              String   @default("procedures")
  /// Live lookups the answer used (getSpot, findProductPrices); never their results.
  toolNames         String[]
  cached            Boolean  @default(false)
  /// True when the first answer cited nothing and a second model call was made.
  retried           Boolean  @default(false)
  /// "slug#anchor" for each section the answer cited.
  citations         String[]
  model             String
  corpusHash        String
  inputTokens       Int
  cachedInputTokens Int
  outputTokens      Int
  /// Whole micro-dollars (1 USD = 1,000,000): exact integers, so the daily spend sum never drifts.
  costMicros        Int
  latencyMs         Int
  /// Failure kind when status is "error" (unavailable, out_of_credit, …).
  error             String?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_question_logs")
}

/// A repeat question's answer, keyed by the normalised scrubbed question and the SOP-set hash,
/// so approving or editing any SOP stops old answers being served. Only questions with nothing
/// to scrub, and answers produced without live-price tools, are ever stored.
model AiAnswerCache {
  id          Int      @id @default(autoincrement())
  questionKey String
  corpusHash  String
  answer      String
  status      String
  /// AiCitation[] as validated when the answer was made.
  citations   Json
  model       String
  hits        Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)

  @@unique([questionKey, corpusHash])
  @@index([expiresAt])
  @@map("ai_answer_cache")
}

/// The company-wide market mode (Weekend / Volatile / Metal Shortage), shared by every user. A single
/// row with id 1; no row means Standard. updatedBy is a display name, kept as text so a deleted user
/// does not orphan it.
model MarketModeState {
  id        Int      @id
  weekend   Boolean  @default(false)
  volatile  Boolean  @default(false)
  shortage  Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("market_mode_state")
}

/// docs/ROADMAP.md as stored for the Project Management page: one row (id 1) holding the whole Markdown.
/// `version` is bumped on every save so two editors cannot silently overwrite each other. The file in
/// the repo stays the reviewed copy: `pnpm --filter api roadmap:import` / `roadmap:export` move it either way.
model RoadmapDocument {
  id        Int      @id
  markdown  String
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("roadmap_document")
}

/// The text the app and master last agreed on, with master's changes taken in (docs/ROADMAP-SYNC-PULL-DESIGN.md).
/// One row, id = 1. Slice 3 compares the app against it to find the app's own edits.
model RoadmapSyncState {
  id           Int      @id
  baseCommit   String
  baseMarkdown String
  syncedAt     DateTime @db.Timestamptz(6)
  syncedBy     String

  @@map("roadmap_sync_state")
}

/// The app's roadmap text as it was just before a sync replaced or changed it. Append-only: nothing in the API
/// updates or deletes a row. Read one back with `pnpm --filter api roadmap:snapshot`.
model RoadmapSnapshot {
  id        Int      @id @default(autoincrement())
  markdown  String
  version   Int
  reason    String
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("roadmap_snapshot")
}

/// Ideas captured as GitHub issues labelled `roadmap` (phone shortcut, the "Idea or task" form), copied here to triage.
/// `status` is new, promoted (became a roadmap task) or dismissed. Rows are never deleted.
model RoadmapInbox {
  id             Int       @id @default(autoincrement())
  /// GitHub issue number; null for queue rows (source phone or web), which have no issue.
  issueNumber    Int?      @unique
  title          String
  body           String    @default("")
  kind           String?
  url            String
  status         String    @default("new")
  issueCreatedAt DateTime  @db.Timestamptz(6)
  fetchedAt      DateTime  @default(now()) @db.Timestamptz(6)
  handledAt      DateTime? @db.Timestamptz(6)
  handledBy      String?
  /// github (an issue), or phone / web (a queued note a laptop session files into docs/INBOX.md).
  source         String    @default("github")

  @@index([status, issueCreatedAt(sort: Desc)])
  @@index([source, status])
  @@map("roadmap_inbox")
}

/// Who changed what from the admin console, the roadmap page and market mode. Written in the same
/// transaction as the change it describes, so an entry exists exactly when the change committed.
/// `actor` is the account email, kept as text so deleting a user never orphans or erases history.
/// Append-only: nothing in the API updates or deletes a row.
model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now()) @db.Timestamptz(6)
  actor  String
  action String
  detail String

  @@index([at(sort: Desc)])
  @@map("audit_log")
}

/// One Business Central item number (a refinery-specific item such as 1015 "Umicore - 250g bar").
/// Many BC items can point at one Goldilocks product (the generic "250g Gold Bar"), so the catalogue
/// keeps one row per product, not per refinery. productId stays null until a person confirms the link.
model BcItem {
  itemNo         String        @id
  /// The description exactly as Business Central shows it. Never used to rename a product.
  description    String
  productId      Int?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  refineryHint   String?
  salesProductId Int?
  salesProduct   SalesProduct? @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([productId])
  @@index([salesProductId])
  @@map("bc_items")
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  RECONCILING
  FINALISED
}

enum SerialsChecked {
  YES
  NO
  NA
}

enum DiscrepancyIssueType {
  QUANTITY
  LOCATION
  SERIAL
  PAID_NOT_COLLECTED
  OTHER
}

/// A month-end count. Reconciles physical stock on countDate to the BC position at cutoffDate.
model Stocktake {
  id            Int             @id @default(autoincrement())
  name          String
  countDate     DateTime        @db.Date
  cutoffDate    DateTime        @db.Date
  status        StocktakeStatus @default(DRAFT)
  stocktakeLead String?
  secondChecker String?
  notes         String?
  createdBy     String
  finalisedBy   String?
  finalisedAt   DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  /// A snapshot loaded from the import workbook, not counted in Goldilocks.
  imported      Boolean         @default(false)
  importBatchId Int?

  lines         StocktakeLine[]
  discrepancies StocktakeDiscrepancy[]
  bars          StocktakeBar[]
  coins         StocktakeCoin[]

  @@index([status])
  @@map("stocktakes")
}

/// One Physical Inventory Journal line. countedNormal/countedCustomer are null until counted: a blank is
/// not a zero. Variance is derived (calculated minus counts) and never stored.
model StocktakeLine {
  id              Int             @id @default(autoincrement())
  stocktakeId     Int
  stocktake       Stocktake       @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemNo          String
  description     String
  locationCode    String
  qtyCalculated   Int
  countedNormal   Int?
  countedCustomer Int?
  counted         Boolean         @default(false)
  reason          String?
  serialsChecked  SerialsChecked?
  serialNote      String?
  batchName       String?
  documentNo      String?
  entryType       String?
  unitAmount      Decimal?        @db.Decimal(14, 5)
  unitCost        Decimal?        @db.Decimal(14, 5)
  sourceKey       String?         @unique

  @@unique([stocktakeId, itemNo, locationCode])
  @@map("stocktake_lines")
}

/// The discrepancy register from the month-end guide. An explanation (action) never sets resolved.
model StocktakeDiscrepancy {
  id            Int                  @id @default(autoincrement())
  stocktakeId   Int
  stocktake     Stocktake            @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemNo        String?
  description   String
  issueType     DiscrepancyIssueType
  bcShows       String               @default("")
  physicalFound String               @default("")
  serialNo      String?
  action        String               @default("")
  resolved      Boolean              @default(false)
  createdBy     String
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  @@index([stocktakeId])
  @@map("stocktake_discrepancies")
}

enum StockMetal {
  GOLD
  SILVER
  PGM
}

enum BarStatus {
  UNCONFIRMED
  CONFIRMED
  NEW
  GONE
}

/// One physical bar in a stocktake's register. A serial identifies a bar when there is one, but a bar without a
/// serial is still a bar: nothing here is invented. UNCONFIRMED means carried from last month and not yet seen.
model StocktakeBar {
  id            Int        @id @default(autoincrement())
  stocktakeId   Int
  stocktake     Stocktake  @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  metal         StockMetal
  locationCode  String
  weightLabel   String
  refinery      String?
  serial        String?
  grams         Decimal?   @db.Decimal(10, 4)
  details       String?
  status        BarStatus  @default(UNCONFIRMED)
  /// The bar row in the earlier stocktake this was carried from. Makes carrying forward repeat-safe.
  carriedFromId Int?
  sourceKey     String?    @unique
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)

  @@index([stocktakeId])
  @@index([stocktakeId, serial])
  @@map("stocktake_bars")
}

/// Coins are counted by product and quantity, never one row per coin. previousQty is last stocktake's count,
/// for reference; countedQty stays null until counted.
model StocktakeCoin {
  id           Int        @id @default(autoincrement())
  stocktakeId  Int
  stocktake    Stocktake  @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  metal        StockMetal
  locationCode String     @default("")
  item         String
  previousQty  Int?
  countedQty   Int?
  details      String?
  /// Per-column counts from the import workbook, kept as written.
  countsJson   Json?
  sourceKey    String?    @unique

  @@unique([stocktakeId, metal, locationCode, item])
  @@map("stocktake_coins")
}

enum CustomerOrderStatus {
  ORDERED
  IN_TRANSIT
  DELIVERED
  BAGGED
  /// Replaces BAGGED. Both exist until code and rows move over; BAGGED is dropped in a later migration.
  ALLOCATED
  COLLECTED
}

enum EvidenceKind {
  TRADESHEET_COLLECTED
  ZOHO_INVOICE
  SIGNED_INVOICE
  BC_RECORD
  STAFF_NOTE
}

/// Custody of goods held for a customer: where it is, not a competing order ledger. Business Central stays the
/// system of record; bcOrderNo and reference point at it. Replaces the Customer Orders spreadsheet.
model CustomerOrderItem {
  id           Int                 @id @default(autoincrement())
  locationCode String
  client       String
  /// Tradesheet reference as written (matching normalises it; the original is kept).
  reference    String?
  bcOrderNo    String?
  supplierRef  String?
  metal        StockMetal?
  product      String
  bcItemNo     String?
  quantity     Int
  refinery     String?
  serials      String?
  status       CustomerOrderStatus @default(ORDERED)
  orderedOn    DateTime?           @db.Date
  missing      Boolean             @default(false)
  notes        String?
  createdBy    String
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  /// The sale this item is held for, once matched.
  tradeId      Int?
  trade        Trade?              @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  evidence CustomerOrderEvidence[]

  @@index([tradeId])
  @@index([status])
  @@index([locationCode, status])
  @@index([reference])
  @@map("customer_order_items")
}

/// Append-only: where each collection claim came from (tradesheet, Zoho or signed invoice, BC). Never edited.
model CustomerOrderEvidence {
  id         Int               @id @default(autoincrement())
  itemId     Int
  item       CustomerOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind       EvidenceKind
  reference  String?
  note       String?
  observedOn DateTime?         @db.Date
  recordedBy String
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)

  @@index([itemId])
  @@map("customer_order_evidence")
}

// --- Tradesheet import (roadmap 1.19) -----------------------------------------------------------------------
// The monthly Google Sheets stay the source; these tables mirror them. A reimport updates a row by its reference.
// Money is Decimal; the importer converts the sheet's numbers at the boundary.

enum TradeState {
  QUOTE
  AWAITING_HEDGE
  HEDGED
  INVOICED
  DEFERRED
  UNKNOWN
}

enum CptyKind {
  EMPTY
  QUOTE_ONLY
  HEDGED
  DEFERRED
  LOT_REF
  SUPPLIER_INVOICE
  OTHER
}

/// How a sale was read as collected: a date or text in the Collected cell, or the green fill.
enum CollectedSource {
  VALUE
  FILL
}

/// One uploaded file. Kept so every row can say which import last touched it.
model ImportBatch {
  id            Int      @id @default(autoincrement())
  fileName      String
  /// The month the file covers, "2026-10".
  sheetMonth    String
  /// TRADESHEET for a monthly export, BACKFILL for the one-off RawG / RawGP tabs.
  source        String   @default("TRADESHEET")
  importedBy    String
  importedAt    DateTime @default(now()) @db.Timestamptz(6)
  /// Counts per tab (added, changed, unchanged, missing, flagged) shown in the preview and kept as the receipt.
  summary       Json
  /// TRADESHEET, WORKBOOK or BC_AWAITING for the Import hub. `source` keeps its old meaning for tradesheet files.
  kind          String   @default("TRADESHEET")
  schemaVersion String?
  /// Workbook imports: rows added, changed, unchanged and flagged per table. Also the resume point.
  tableCounts   Json?
  /// OPEN while a chunked import is still being sent, COMPLETE once the last table is in.
  status        String   @default("COMPLETE")

  trades Trade[]
  lots   PurchaseLot[]

  @@index([sheetMonth])
  @@map("import_batches")
}

/// A sale row in IE - Gold or IE - Silver. A Deferred sale keeps its row; the row it was carried to has its own
/// reference and the two are linked through deferredFrom / deferredTo.
model Trade {
  id           Int        @id @default(autoincrement())
  /// As written in the sheet. referenceKey is the form references are compared in (spacing, case and hyphens folded).
  reference    String
  referenceKey String
  /// 1 for the first row with this reference, 2 for a repeat. Repeats are history errors and are flagged, not merged.
  occurrence   Int        @default(1)
  metal        StockMetal
  branchCode   String?
  branchId     Int?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  initials     String?
  client       String
  qty          Int?
  /// The product cell as written. productKey is the catalogue key it matched; productId the Goldilocks product.
  productText  String
  productKey   String?
  productId    Int?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  date         DateTime?  @db.Date
  spot         Decimal?   @db.Decimal(12, 4)

  cptyRaw         String?
  cptyKind        CptyKind
  state           TradeState
  /// True when the state came from the cell colour (an empty CPTY filled blue). The preview marks these.
  stateFromColour Boolean          @default(false)
  /// The purchase line named in CPTY, in the form lots are compared in.
  lotKey          String?
  /// The imported purchase lot that line resolves to. Null while lotKey is empty, or names a lot that is not imported.
  lotId           Int?
  lot             PurchaseLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  supplierName    String?
  supplierInvoice String?
  collected       Boolean          @default(false)
  collectedSource CollectedSource?
  collectedOn     DateTime?        @db.Date
  deferredFrom    String[]
  deferredTo      String[]

  cost         Decimal? @db.Decimal(14, 4)
  receipt      Decimal? @db.Decimal(14, 4)
  profit       Decimal? @db.Decimal(14, 4)
  margin       Decimal? @db.Decimal(10, 6)
  vatDue       Decimal? @db.Decimal(14, 4)
  totalPrice   Decimal? @db.Decimal(14, 4)
  netHedging   Decimal? @db.Decimal(14, 4)
  boughtAt     Decimal? @db.Decimal(14, 4)
  soldAt       Decimal? @db.Decimal(14, 4)
  paid         String?
  notes        String?
  hedgingNotes String?

  sourceMonth       String
  sourceTab         String
  sourceRow         Int
  /// Hash of the fields a person can edit in the sheet; a changed hash on reimport means the row changed.
  fingerprint       String
  /// Set when a reimport no longer finds the row. Nothing is deleted: a person confirms or restores it.
  missingFromImport Boolean     @default(false)
  /// What the parser could not read. Empty for a clean row.
  issues            String[]
  firstBatchId      Int
  lastBatchId       Int
  lastBatch         ImportBatch @relation(fields: [lastBatchId], references: [id])
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  /// Workbook import. The tradesheet importer never writes these; it still owns the rest of the row.
  sourceKey          String?             @unique
  system             OrderSystem?
  cptyFill           String?
  refinery           String?
  customerId         Int?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierInvoiceId  Int?
  supplierInvoiceRef SupplierInvoice?    @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  salesProductId     Int?
  salesProduct       SalesProduct?       @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  quotes             Quote[]
  orderItems         CustomerOrderItem[]

  /// Items of the matched purchase line this sale uses. Empty until the sale is matched.
  units  StockUnit[]
  events OrderEvent[]
  tasks  SheetTask[]

  bcShipments BcShipment[]
  itemEvents  ItemEvent[]

  @@unique([referenceKey, occurrence])
  @@index([customerId])
  @@index([supplierInvoiceId])
  @@index([salesProductId])
  @@index([sourceMonth])
  @@index([state])
  @@index([lotKey])
  @@index([lotId])
  @@index([metal, date])
  @@map("trades")
}

/// A purchase row in IE-GP or IE-SP: one batch of items bought at one price on one day.
model PurchaseLot {
  id           Int        @id @default(autoincrement())
  reference    String
  referenceKey String
  occurrence   Int        @default(1)
  metal        StockMetal
  branchCode   String?
  branchId     Int?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Who the goods were bought from (a customer selling, or a supplier invoice).
  client       String
  qty          Int?
  productText  String
  productKey   String?
  productId    Int?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  received     DateTime?  @db.Date
  datePaid     DateTime?  @db.Date
  pricePaid    Decimal?   @db.Decimal(14, 4)
  pricePerItem Decimal?   @db.Decimal(14, 4)
  hedgedAt     Decimal?   @db.Decimal(14, 4)
  melt         Boolean    @default(false)

  /// The Comments cell as written. The sheets only record what was sold here, as text like "3 sold".
  commentsRaw    String?
  /// What that text says. The sales that cite this lot are the real figure; a difference goes to the review list.
  commentSoldQty Int?
  commentAllSold Boolean @default(false)
  commentReview  Boolean @default(false)
  /// Items the imported sales say they took from this lot (the sum of their quantities). Remaining is qty minus this.
  allocatedQty   Int     @default(0)

  sourceMonth       String
  sourceTab         String
  sourceRow         Int
  fingerprint       String
  missingFromImport Boolean     @default(false)
  issues            String[]
  firstBatchId      Int
  lastBatchId       Int
  lastBatch         ImportBatch @relation(fields: [lastBatchId], references: [id])
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  /// Workbook import.
  sourceKey          String?          @unique
  system             OrderSystem?
  refinery           String?
  sellerId           Int?
  seller             Customer?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  supplierInvoiceId  Int?
  supplierInvoiceRef SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  salesProductId     Int?
  salesProduct       SalesProduct?    @relation(fields: [salesProductId], references: [id], onDelete: SetNull)

  units  StockUnit[]
  trades Trade[]

  @@unique([referenceKey, occurrence])
  @@index([sellerId])
  @@index([supplierInvoiceId])
  @@index([sourceMonth])
  @@index([metal, productKey])
  @@map("purchase_lots")
}

/// One physical item bought. Gold gets a row per item at purchase (seq 1..qty); silver stays at lot quantity for now.
/// tradeId is the sale that item went to, null while it is in stock.
model StockUnit {
  id      Int         @id @default(autoincrement())
  lotId   Int
  lot     PurchaseLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  seq     Int
  tradeId Int?
  trade   Trade?      @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@unique([lotId, seq])
  @@index([tradeId])
  @@map("stock_units")
}

/// A cleaned product name from the sheets ("1oz tree of life") and what it was settled to: a specific product
/// (salesProductId), or a pricing product for generic names (productId). Filled from the import workbook and the
/// review queue.
model ProductAlias {
  id             Int           @id @default(autoincrement())
  /// Cleaned alias text, the form product text is compared in.
  alias          String        @unique
  productKey     String
  productId      Int?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Alias queue: the specific sales product (product + refinery) this text resolves to, once a person confirms it.
  salesProductId Int?
  salesProduct   SalesProduct? @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  refinery       String?
  /// A name settled as not a product, e.g. a fee or deposit.
  noProduct      Boolean       @default(false)
  uses           Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  /// Comma list of where the name was seen (e.g. "stock_bars,invoice_lines").
  sources                 String?
  /// The metal of the tab or source the name came from, when it says one.
  metalHint               MetalType?
  /// Who settled the name: RULE (the matching engine, undoable) or PERSON. Null while undecided.
  decidedBy               AliasDecider?
  /// What the engine suggests for a name it is not sure of; nothing here is applied until a person accepts it.
  suggestedProductId      Int?
  suggestedProduct        Product?         @relation("AliasSuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: SetNull)
  suggestedSalesProductId Int?
  suggestedSalesProduct   SalesProduct?    @relation("AliasSuggestedSalesProduct", fields: [suggestedSalesProductId], references: [id], onDelete: SetNull)
  suggestedNoProduct      Boolean          @default(false)
  confidence              MatchConfidence?
  /// Why the engine decided or suggested what it did.
  reason                  String?
  /// For a LIKELY suggestion: the question put to the person.
  question                String?
  /// The name needs a catalogue row that does not exist yet.
  catalogueGap            Boolean          @default(false)

  @@index([productKey])
  @@index([salesProductId])
  @@index([decidedBy])
  @@map("product_aliases")
}

/// Who settled a product name.
enum AliasDecider {
  RULE
  PERSON
}

/// How sure the matching engine is of a product name.
enum MatchConfidence {
  CERTAIN
  LIKELY
  UNCLEAR
}

enum ProductRuleKind {
  WORD
  DESIGN
  DEFAULT
  NOT_A_PRODUCT
  SHEET_METAL
}

/// A matching rule the owner can edit (a word, a coin design, a default, a non-product phrase, a sheet's metal).
/// The engine ships with built-in rules; rows here are for the rules page.
model ProductRule {
  id        Int             @id @default(autoincrement())
  kind      ProductRuleKind
  pattern   String
  value     Json
  note      String?
  active    Boolean         @default(true)
  createdBy String
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([kind, pattern])
  @@map("product_rules")
}

/// One Zoho item with what was sold of it (the workbook's zoho_products table). A SKU that is a BC item number
/// carries that item's products.
model ZohoProduct {
  id                Int           @id @default(autoincrement())
  sourceKey         String        @unique
  sku               String?
  itemName          String
  productNorm       String?
  metal             String?
  qtySold           Decimal?      @db.Decimal(14, 4)
  amount            Decimal?      @db.Decimal(14, 4)
  avgPrice          Decimal?      @db.Decimal(14, 4)
  productId         Int?
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  salesProductId    Int?
  salesProduct      SalesProduct? @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  missingFromImport Boolean       @default(false)
  importBatchId     Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  @@index([sku])
  @@index([productId])
  @@index([salesProductId])
  @@map("zoho_products")
}

enum OrderStep {
  ORDERED
  ARRIVED
  ALLOCATED
  MATCHED
  COLLECTED
  POSTED
}

enum SheetTaskStatus {
  OPEN
  DONE
}

enum TaskCheck {
  TRADE_COLLECTED
  TRADE_CPTY
  MANUAL
}

enum TaskClosedVia {
  MANUAL
  IMPORT
}

/// A step staff took on an order. Append-only. The tradesheet stays the source of truth, so this sits beside the
/// imported Trade row instead of changing it, and an import can never overwrite it.
model OrderEvent {
  id      Int       @id @default(autoincrement())
  tradeId Int
  trade   Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  step    OrderStep
  by      String
  at      DateTime  @default(now()) @db.Timestamptz(6)
  note    String?

  @@index([tradeId])
  @@map("order_events")
}

/// A change staff must make by hand in a sheet, with the exact value to paste. Closed by a person, or by an import
/// that shows the change.
model SheetTask {
  id        Int             @id @default(autoincrement())
  tradeId   Int?
  trade     Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  reference String
  client    String
  sheet     String
  what      String
  value     String
  check     TaskCheck
  status    SheetTaskStatus @default(OPEN)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  createdBy String
  closedAt  DateTime?       @db.Timestamptz(6)
  closedBy  String?
  closedVia TaskClosedVia?

  @@index([status])
  @@index([tradeId])
  @@map("sheet_tasks")
}

/// The note one person leaves for the next when they close the day.
model Handover {
  id        Int      @id @default(autoincrement())
  note      String
  by        String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("handovers")
}

// --- Import workbook (assembled from Zoho, Business Central and the tradesheets) ---------------------------------
// Every imported row has a sourceKey (the workbook id), unique, so importing the same file twice changes nothing.
// A row that disappears from a newer file is flagged missingFromImport, never deleted. Admin and manager only:
// the API enforces it, and row level security gives Supabase's own REST roles nothing. Names live only in
// Customer and Vendor; every other row points at them by id.

enum OrderSystem {
  ZOHO
  BC
}

enum CollectedFlag {
  YES
  NO
  CHECK
}

enum QuoteStatus {
  OPEN
  INVOICED
  EXPIRED
}

enum LinkConfidence {
  EXACT
  PROBABLE
}

enum LinkStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Customer {
  id                Int      @id @default(autoincrement())
  /// The redacted code (C000123), the workbook's own id for the customer.
  redactionCode     String   @unique
  /// Real name, restored in the owner's browser before upload. Never logged, in a URL, or sent to an AI model.
  name              String
  zohoNumber        String?
  /// Business Central customer no. (PRV…), learnt from posted shipments. Never overwritten once set.
  bcCustomerNo      String?
  /// Business Central vendor no. when this person sold to us in BC (a separate card from the customer one).
  bcVendorNo        String?
  status            String?
  currency          String?
  sources           String?
  missingFromImport Boolean  @default(false)
  importBatchId     Int
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  trades      Trade[]
  lots        PurchaseLot[]
  invoices    ZohoInvoice[]
  lines       ZohoInvoiceLine[]
  payments    ZohoPayment[]
  bcOrders    BcSalesOrder[]
  quotes      Quote[]
  bcShipments BcShipment[]
  bcReceipts  BcReceipt[]
  itemEvents  ItemEvent[]

  @@index([name])
  @@index([bcCustomerNo])
  @@index([bcVendorNo])
  @@map("customers")
}

model Vendor {
  id                Int      @id @default(autoincrement())
  redactionCode     String   @unique
  name              String
  zohoNumber        String?
  status            String?
  currency          String?
  sources           String?
  missingFromImport Boolean  @default(false)
  importBatchId     Int
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  purchaseOrderLines ZohoPurchaseOrderLine[]

  @@index([name])
  @@map("vendors")
}

model SupplierInvoice {
  id                Int       @id @default(autoincrement())
  sourceKey         String    @unique
  supplier          String
  number            String
  firstDate         DateTime? @db.Date
  lastDate          DateTime? @db.Date
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  trades Trade[]
  lots   PurchaseLot[]

  @@unique([supplier, number])
  @@map("supplier_invoices")
}

/// The specific product an invoice, order, stock row or BC item refers to ("1oz Valcambi Suisse bar").
/// It maps to exactly one pricing product, the reduced catalogue behind the price table.
model SalesProduct {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  metal            StockMetal
  /// The workbook's product_norm for the generic version, e.g. "1oz bar".
  genericNorm      String
  weightLabel      String?
  /// Normalised refinery; null for coins.
  refinery         String?
  pricingProductId Int?
  pricingProduct   Product?   @relation(fields: [pricingProductId], references: [id], onDelete: SetNull)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  bcItems          BcItem[]
  aliases          ProductAlias[]
  trades           Trade[]
  lots             PurchaseLot[]
  invoiceLines     ZohoInvoiceLine[]
  quotes           Quote[]
  suggestedAliases ProductAlias[]    @relation("AliasSuggestedSalesProduct")
  zohoProducts     ZohoProduct[]

  @@index([genericNorm, refinery])
  @@index([pricingProductId])
  @@map("sales_products")
}

/// A spelling of a refinery seen in the data and the canonical refinery it stands for.
model RefineryAlias {
  id        Int      @id @default(autoincrement())
  alias     String   @unique
  refinery  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("refinery_aliases")
}

/// A tradesheet row with QUOTE_ONLY. Not a trade: it reserves nothing. When a later import shows the same
/// reference with a real counterparty it becomes INVOICED and points at the Trade.
model Quote {
  id                Int           @id @default(autoincrement())
  sourceKey         String        @unique
  reference         String
  referenceKey      String
  date              DateTime?     @db.Date
  metal             StockMetal
  branchCode        String?
  qty               Decimal?      @db.Decimal(14, 4)
  productText       String
  productNorm       String?
  customerId        Int?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesProductId    Int?
  salesProduct      SalesProduct? @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  status            QuoteStatus   @default(OPEN)
  convertedTradeId  Int?
  convertedTrade    Trade?        @relation(fields: [convertedTradeId], references: [id], onDelete: SetNull)
  missingFromImport Boolean       @default(false)
  importBatchId     Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  @@index([referenceKey])
  @@index([status])
  @@index([customerId])
  @@map("quotes")
}

/// Zoho invoice history. Read-only in the app.
model ZohoInvoice {
  id                Int       @id @default(autoincrement())
  sourceKey         String    @unique
  date              DateTime? @db.Date
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            String?
  salesOrderNumber  String?
  total             Decimal?  @db.Decimal(14, 4)
  lineCount         Int?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  lines       ZohoInvoiceLine[]
  payments    ZohoPayment[]
  bcShipments BcShipment[]

  @@index([customerId, date])
  @@map("zoho_invoices")
}

model ZohoInvoiceLine {
  id                Int            @id @default(autoincrement())
  sourceKey         String         @unique
  invoiceId         Int
  invoice           ZohoInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo            Int?
  date              DateTime?      @db.Date
  customerId        Int?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  qty               Decimal?       @db.Decimal(14, 4)
  itemName          String
  productNorm       String?
  unitPrice         Decimal?       @db.Decimal(14, 4)
  lineTotal         Decimal?       @db.Decimal(14, 4)
  itemDesc          String?
  collectedFlag     CollectedFlag?
  collectedDate     DateTime?      @db.Date
  refinery          String?
  salesProductId    Int?
  salesProduct      SalesProduct?  @relation(fields: [salesProductId], references: [id], onDelete: SetNull)
  deliveredBrinks   Boolean?
  soldBack          Boolean?
  refsFound         String?
  missingFromImport Boolean        @default(false)
  importBatchId     Int
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  serials LineSerial[]

  @@index([invoiceId])
  @@index([customerId, date])
  @@index([salesProductId])
  @@map("zoho_invoice_lines")
}

model LineSerial {
  id                Int             @id @default(autoincrement())
  sourceKey         String          @unique
  lineId            Int
  line              ZohoInvoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial            String
  serialNorm        String
  refinery          String?
  collectedFlag     CollectedFlag?
  collectedDate     DateTime?       @db.Date
  missingFromImport Boolean         @default(false)
  importBatchId     Int
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@index([serialNorm])
  @@index([lineId])
  @@map("line_serials")
}

model ZohoPayment {
  id                Int          @id @default(autoincrement())
  sourceKey         String       @unique
  invoiceId         Int?
  invoice           ZohoInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId        Int?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  zohoCustomerId    String?
  date              DateTime?    @db.Date
  invoiceDate       DateTime?    @db.Date
  amount            Decimal?     @db.Decimal(14, 4)
  invoiceAmount     Decimal?     @db.Decimal(14, 4)
  mode              String?
  reference         String?
  type              String?
  missingFromImport Boolean      @default(false)
  importBatchId     Int
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  @@index([invoiceId])
  @@index([customerId, date])
  @@map("zoho_payments")
}

model ZohoPurchaseOrderLine {
  id                Int       @id @default(autoincrement())
  sourceKey         String    @unique
  poNumber          String
  lineNo            Int?
  date              DateTime? @db.Date
  vendorNumber      String?
  vendorId          Int?
  vendor            Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  itemName          String
  productNorm       String?
  qtyOrdered        Decimal?  @db.Decimal(14, 4)
  qtyReceived       Decimal?  @db.Decimal(14, 4)
  qtyBilled         Decimal?  @db.Decimal(14, 4)
  price             Decimal?  @db.Decimal(14, 4)
  itemTotal         Decimal?  @db.Decimal(14, 4)
  status            String?
  reference         String?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([poNumber])
  @@index([vendorId])
  @@map("zoho_purchase_order_lines")
}

/// A row of the Business Central "Orders Awaiting Collection" report. A trade whose BC order is absent from a
/// fresh report is POSTED.
model BcSalesOrder {
  id                Int       @id @default(autoincrement())
  sourceKey         String    @unique
  branchCode        String?
  snapshot          String?
  snapshotDate      DateTime? @db.Date
  bcCustomerNo      String?
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  extDocNo          String?
  extDocCore        String?
  location          String?
  docDate           DateTime? @db.Date
  amount            Decimal?  @db.Decimal(14, 4)
  amountInclVat     Decimal?  @db.Decimal(14, 4)
  prepaid           Decimal?  @db.Decimal(14, 4)
  remaining         Decimal?  @db.Decimal(14, 4)
  paid              Boolean?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([extDocCore])
  @@index([customerId])
  @@map("bc_sales_orders")
}

model BcTrackingEntry {
  id                Int       @id @default(autoincrement())
  sourceKey         String    @unique
  snapshot          String?
  entryNo           String?
  itemNo            String
  locationCode      String?
  serialNo          String?
  serialNorm        String?
  lotNo             String?
  remainingQuantity Decimal?  @db.Decimal(14, 4)
  postingDate       DateTime? @db.Date
  documentNo        String?
  entryType         String?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([serialNorm])
  @@index([itemNo, locationCode])
  @@map("bc_tracking_entries")
}

/// One suggested or confirmed relation between two imported rows, both named by sourceKey: trade to purchase line,
/// invoice line to trade, trade to supplier invoice, trade to BC order, serial to stock bar, and the evidence that
/// a package arrived. EXACT links are applied and stored CONFIRMED; PROBABLE wait as PENDING until an admin decides.
model EntityLink {
  id            Int            @id @default(autoincrement())
  linkType      String
  fromTable     String
  fromKey       String
  toTable       String
  toKey         String
  method        String
  confidence    LinkConfidence
  status        LinkStatus     @default(PENDING)
  note          String?
  confirmedBy   String?
  confirmedAt   DateTime?      @db.Timestamptz(6)
  importBatchId Int?
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([linkType, fromTable, fromKey, toTable, toKey])
  @@index([status, linkType])
  @@index([fromTable, fromKey])
  @@index([toTable, toKey])
  @@map("entity_links")
}

// --- Business Central history and serial trace (roadmap 1.21) -----------------------------------------------------
// Snapshots of posted BC documents, upserted by their BC number; BC stays the system of record. Each bar (one serial)
// is an Item, and every BC ledger entry that moved it is an append-only ItemEvent, so a serial can be followed from
// the vendor it was bought from to the customer who collected it. Coins are not tracked one by one.

/// A posted sales shipment. Posted when the customer collects, so it is the collection record.
model BcShipment {
  id                Int          @id @default(autoincrement())
  no                String       @unique
  customerNo        String?
  customerId        Int?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  documentDate      DateTime?    @db.Date
  postingDate       DateTime?    @db.Date
  /// Free text staff type in BC: a tradesheet reference, a Zoho invoice no., a supplier reference, or nothing.
  externalDocNo     String?
  locationCode      String?
  /// The sale the external document no. names, when it is a tradesheet reference.
  tradeId           Int?
  trade             Trade?       @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  zohoInvoiceId     Int?
  zohoInvoice       ZohoInvoice? @relation(fields: [zohoInvoiceId], references: [id], onDelete: SetNull)
  missingFromImport Boolean      @default(false)
  importBatchId     Int
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  @@index([customerId])
  @@index([tradeId])
  @@index([customerNo])
  @@map("bc_shipments")
}

model BcShipmentLine {
  id                Int      @id @default(autoincrement())
  /// "<document no.>|<line position>": the export has no line number of its own.
  sourceKey         String   @unique
  documentNo        String
  lineNo            Int
  customerNo        String?
  itemNo            String?
  description       String?
  locationCode      String?
  quantity          Decimal? @db.Decimal(14, 4)
  missingFromImport Boolean  @default(false)
  importBatchId     Int
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([documentNo])
  @@index([itemNo])
  @@map("bc_shipment_lines")
}

/// A posted purchase receipt (GRN). Private sellers (PRV vendor no.) resolve to a customer; companies are suppliers.
model BcReceipt {
  id                Int       @id @default(autoincrement())
  no                String    @unique
  vendorNo          String?
  /// The private seller, when the vendor is a person in the customers table.
  sellerId          Int?
  seller            Customer? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  documentDate      DateTime? @db.Date
  locationCode      String?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([vendorNo])
  @@index([sellerId])
  @@map("bc_receipts")
}

/// One BC item ledger entry: every stock movement (receipt, shipment, adjustment, transfer, return).
model BcLedgerEntry {
  id                Int       @id @default(autoincrement())
  entryNo           Int       @unique
  postingDate       DateTime? @db.Date
  entryType         String
  documentType      String?
  documentNo        String
  itemNo            String
  locationCode      String?
  quantity          Decimal   @db.Decimal(14, 4)
  remainingQuantity Decimal?  @db.Decimal(14, 4)
  salesAmount       Decimal?  @db.Decimal(14, 4)
  costAmount        Decimal?  @db.Decimal(14, 4)
  open              Boolean?
  /// Serial No. as pasted from BC (placeholders dropped); serialKey is the form serials are matched in.
  serialNo          String?
  serialKey         String?
  /// Customer or Vendor, and that party's BC number.
  sourceType        String?
  sourceNo          String?
  missingFromImport Boolean   @default(false)
  importBatchId     Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([documentNo])
  @@index([itemNo, locationCode])
  @@index([serialKey])
  @@index([sourceNo])
  @@map("bc_ledger_entries")
}

enum ItemStatus {
  IN_STOCK
  COLLECTED
  GONE
  UNKNOWN
}

enum ItemEventKind {
  RECEIVED
  OPENING_BALANCE
  ADJUSTED_IN
  ADJUSTED_OUT
  TRANSFERRED
  COLLECTED
  RETURNED_BY_CUSTOMER
  RETURNED_TO_VENDOR
}

enum ItemEventSource {
  BC
  ZOHO
  TRADESHEET
  STOCKTAKE
  STAFF
}

/// One physical bar, by serial. A bar bought back is the same row with new events. Status and location are the
/// latest event's; they are kept here only so lists do not have to read every event.
model Item {
  id           Int        @id @default(autoincrement())
  serial       String
  /// Upper case, letters and digits only. Two refineries can share a serial; a clash goes to review, not a new row.
  serialKey    String     @unique
  bcItemNo     String?
  productId    Int?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  status       ItemStatus @default(UNKNOWN)
  locationCode String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)

  events ItemEvent[]

  @@index([bcItemNo])
  @@index([status])
  @@map("items")
}

/// Append-only: one fact about one bar and where it came from. Never edited by hand.
model ItemEvent {
  id           Int             @id @default(autoincrement())
  itemId       Int
  item         Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         ItemEventKind
  date         DateTime?       @db.Date
  source       ItemEventSource
  /// The document: GRN-…, SHP-…, INV-…, a stocktake. sourceKey makes a re-import change nothing ("BC|<entry no.>|<serial>").
  sourceRef    String?
  sourceKey    String          @unique
  locationCode String?
  /// BC customer or vendor no. on the document.
  partyNo      String?
  customerId   Int?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tradeId      Int?
  trade        Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  quantity     Decimal         @db.Decimal(14, 4)
  /// Sales or cost amount of the ledger entry (the whole entry, not per bar when the entry moved several).
  amount       Decimal?        @db.Decimal(14, 4)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  @@index([itemId, date])
  @@index([customerId])
  @@index([tradeId])
  @@map("item_events")
}
