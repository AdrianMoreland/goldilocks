{
  "extends": "@goldilocks/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "prisma/generated/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
