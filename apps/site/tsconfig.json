{
  "extends": "@goldilocks/typescript-config/react-library.json",
  "include": ["**/*", ".react-router/types/**/*"],
  "exclude": ["node_modules", "build"],
  "compilerOptions": {
    "types": ["vite/client"],
    "rootDirs": [".", "./.react-router/types"],
