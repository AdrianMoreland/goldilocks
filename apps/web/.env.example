# Web build settings. Copy to apps/web/.env for local overrides; every value has a default in code.

# API base URL (default http://localhost:3000). Production sets it in the hosting service.
VITE_API_URL=http://localhost:3000

# Base path when served from a subdirectory (default: none)
VITE_BASENAME=

# Google Tag Manager ID, production only (default: none, no tracking)
VITE_GTM_ID=
